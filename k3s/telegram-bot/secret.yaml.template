# Copy to secret.yaml (gitignored), fill in real values, `kubectl apply -f`.
# Pull values from the `agents` 1Password vault where they're stored, e.g.:
#   op read op://agents/todo-telegram-bot/token
apiVersion: v1
kind: Secret
metadata:
  name: todo-telegram-bot-secrets
  namespace: todo-bot
type: Opaque
stringData:
  TELEGRAM_BOT_TOKEN: REPLACE_ME
  TELEGRAM_ALLOWED_USER_ID: REPLACE_ME
  # Only one of these is required — whichever TODO_DEFAULT_AI_PROVIDER below points at.
  OPENAI_API_KEY: REPLACE_ME
  ANTHROPIC_API_KEY: REPLACE_ME
